{
  "name": "presidente-vargas-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MVP 3D web da Avenida Presidente Vargas (Rio de Janeiro) — Central do Brasil → Candelária",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "map:fetch": "tsx tools/fetch_map_data.ts",
    "map:process": "tsx tools/process_osm.ts",
    "map:build": "tsx tools/build_world.ts",
    "map": "npm run map:process && npm run map:build",
    "server": "npm --prefix server run dev",
    "server:install": "npm --prefix server install",
    "verify": "tsc --noEmit && vitest run --reporter=dot && vite build --logLevel error && (cd server && npx tsc -p .)",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.170.0",
    "clipper-lib": "^6.4.2",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
