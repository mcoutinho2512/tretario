# Modelo do env de PRODUÇÃO (deploy/CONTRACT.md). Sem segredo real: o provision-vps.sh copia para
# /opt/tretario/shared/env/server.env (600, dono tretario) trocando os __MARCADORES__ por valores gerados,
# e NUNCA sobrescreve um arquivo existente. Sintaxe simples CHAVE=valor (lida pelo systemd e pelo bash).
NODE_ENV=production
PORT=2567
HOST=127.0.0.1
PV_PUBLIC_ORIGIN=https://__DOMAIN__
PV_TRUST_PROXY=loopback
DATABASE_URL=postgresql://tretario:__DB_PASSWORD__@127.0.0.1:5432/tretario
PV_SESSION_SECRET=__SESSION_SECRET__
PV_ADMIN_TOKEN=__ADMIN_TOKEN__
PV_REGISTRATION=beta
MAX_PLAYERS_PER_ROOM=150
MAX_SPECTATORS_PER_ROOM=300
PV_GRAFFITI_FILE=/opt/tretario/shared/data/graffiti.json
PV_TELEMETRY_FILE=/opt/tretario/shared/data/telemetry.jsonl
PV_LOG_FORMAT=json
# desligamento gracioso (< TimeoutStopSec=20 do tretario.service)
PV_SHUTDOWN_MS=14000
# entradas no WebSocket por minuto (padrões do app; 0 desliga)
# PV_JOIN_RATE_IP=120
# PV_JOIN_RATE_USER=20
# CLEANUP_*: padrões (docs/DATABASE.md)
# PROIBIDOS em produção (o servidor recusa subir): PV_TEST, PV_ALLOW_ANON_PLAYERS, PV_DEV_MAIL, PV_STORE=memory
