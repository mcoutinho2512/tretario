{
  "name": "presidente-vargas-3d-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor multiplayer de DESENVOLVIMENTO (Colyseus). Não fazer deploy sem autorização.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:up": "docker compose -f ../docker-compose.yml up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "prepare": "prisma generate",
    "test:db": "tsx tools/test-db.ts",
    "admin": "tsx tools/admin.ts",
    "telemetry": "tsx tools/telemetry.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.8",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  }
}
