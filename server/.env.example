# copie para server/.env (gitignored). Somente desenvolvimento local.
DATABASE_URL="postgresql://pv:pv_dev@127.0.0.1:5433/pv3d?schema=public"
# banco separado para testes de integração (o script cria o schema)
DATABASE_URL_TEST="postgresql://pv:pv_dev@127.0.0.1:5433/pv3d?schema=test"
# segredo das sessões/tickets (gere outro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PV_SESSION_SECRET="dev-only-change-me"
# caixa de saída de e-mail de DEV em /api/dev/outbox (testes automatizados; ignorado em produção)
# PV_DEV_MAIL="1"
# token da mensagem gf_admin (CLI dev:remove-graffiti com o servidor no ar) — mesmo valor no servidor e na CLI
# PV_ADMIN_TOKEN=""
