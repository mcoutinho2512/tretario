# copie para server/.env (gitignored). Somente desenvolvimento local.
DATABASE_URL="postgresql://pv:pv_dev@127.0.0.1:5433/pv3d?schema=public"
# banco separado para testes de integração (o script cria o schema)
DATABASE_URL_TEST="postgresql://pv:pv_dev@127.0.0.1:5433/pv3d?schema=test"
# segredo das sessões/tickets (gere outro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PV_SESSION_SECRET="dev-only-change-me"
# caixa de saída de e-mail de DEV em /api/dev/outbox (testes automatizados; ignorado em produção)
# PV_DEV_MAIL="1"
# token da mensagem gf_admin (CLI dev:remove-graffiti com o servidor no ar) — mesmo valor no servidor e na CLI;
# rodada 9.1: também o header x-admin-token de GET /internal/health. Produção: 32+ caracteres aleatórios, ≠ PV_SESSION_SECRET
# PV_ADMIN_TOKEN=""
# limpeza de efêmeros vencidos (sessões, códigos, tickets, limites) — docs/DATABASE.md. 0 desliga o agendamento
# CLEANUP_INTERVAL_MINUTES="10"
# CLEANUP_SESSION_GRACE_MINUTES="60"
# CLEANUP_CODE_GRACE_MINUTES="60"
# CLEANUP_BATCH="500"
# CLEANUP_MAX_RUN_MS="30000"

# ---------------------------------------------------------------- rodada 9.1 — produção (docs/SECURITY_PRODUCTION.md)
# Em produção o servidor RECUSA subir sem estes (e com PV_TEST/PV_ALLOW_ANON_PLAYERS/PV_DEV_MAIL/PV_STORE=memory):
# NODE_ENV="production"
# PV_PUBLIC_ORIGIN="https://exemplo.com.br"   # origem exata (CORS/Origin), sem barra no fim
# PV_TRUST_PROXY="loopback"                   # X-Real-IP/X-Forwarded-For só vindos de 127.0.0.1 (Nginx local)
# PV_REGISTRATION="beta"                      # beta (produção, sem SMTP) · open (padrão dev) · dev
# lotação por sala (substitui PV_MAX_CLIENTS, que continua valendo sem estas)
# MAX_PLAYERS_PER_ROOM="150"
# MAX_SPECTATORS_PER_ROOM="300"
# entradas no WebSocket por minuto (0 desliga; PV_TEST=1 desliga por padrão)
# PV_JOIN_RATE_IP="120"
# PV_JOIN_RATE_USER="20"
# logs estruturados (journald) e prazo do desligamento gracioso
# PV_LOG_FORMAT="json"
# PV_SHUTDOWN_MS="14000"
# versão do build quando não há version.json (npm run build:version)
# PV_BUILD_COMMIT=""
# PV_BUILD_TIME=""
# desenvolvimento: silencia a conversa de jogo no console (entrou no carro, queda…)
# PV_LOG_QUIET="1"
